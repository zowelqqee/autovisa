# ==== Обязательные ====

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=1234567890:AAAAaaaaBBBBbbbbCCCCccccDDDDddddEEE

# Ключ OpenAI API (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ID ГРУППОВОГО чата менеджеров (не личка!).
# Для супергрупп id отрицательный и начинается с -100.
# Как получить — см. README, раздел «Шаг 3».
MANAGER_CHAT_ID=-1001234567890


# ==== Google Sheets CRM (опционально, но требуется для автозаполнения CRM) ====
# TODO: создайте service account в Google Cloud, включите Google Sheets API,
# скачайте JSON-ключ и откройте таблицу на email service account как Редактор.
# Полная пошаговая инструкция — в README, раздел «Google Sheets CRM».
#
# ID находится в URL таблицы между /d/ и /edit:
# https://docs.google.com/spreadsheets/d/<ЭТОТ_ID>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=TODO_вставьте_ID_таблицы

# Имя вкладки с CRM. Создайте в ней строку заголовков из задания.
GOOGLE_SHEETS_WORKSHEET=CRM

# Вариант 1 (локально): путь к скачанному JSON-ключу service account.
# GOOGLE_SERVICE_ACCOUNT_FILE=./credentials/google-service-account.json

# Вариант 2 (Render/облако): содержимое JSON-ключа одной переменной окружения.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}


# ==== Модель ====

# Чат-модель. По умолчанию gpt-5.4-mini — выбрана замером: ~2 с на ответ
# против ~4 с у gpt-5.5 при том же качестве на этом сценарии.
# OPENAI_MODEL=gpt-5.4-mini

# Глубина рассуждений: none | low | medium | high (по умолчанию low)
# OPENAI_EFFORT=low

# Максимум токенов в ответе (по умолчанию 2048)
# OPENAI_MAX_OUTPUT_TOKENS=2048


# ==== Голосовые сообщения ====

# 1 — бот отвечает на голосовые голосом (по умолчанию), 0 — просит писать текстом
# VOICE_ENABLED=1

# Распознавание речи (по умолчанию gpt-4o-mini-transcribe)
# OPENAI_STT_MODEL=gpt-4o-mini-transcribe

# Синтез речи (по умолчанию gpt-4o-mini-tts)
# OPENAI_TTS_MODEL=gpt-4o-mini-tts

# Голос: alloy, echo, fable, onyx, nova, shimmer, coral, sage (по умолчанию alloy)
# OPENAI_TTS_VOICE=alloy

# Язык распознавания — подсказка заметно повышает точность (по умолчанию ru)
# OPENAI_STT_LANGUAGE=ru


# ==== Опциональные лимиты (по умолчанию ВЫКЛЮЧЕНЫ) ====
# 0 = без ограничения. Пригодятся, чтобы подстраховаться от неожиданного
# счёта: запрос отсекается до отправки, а не ловится по 429.

# OPENAI_RPM=0
# OPENAI_RPD=0
# OPENAI_TPD=0
# OPENAI_QUOTA_TZ=UTC


# ==== Прочее ====

# HTTP(S)-прокси для Telegram API (если IP VPS заблокирован в регионе).
# Пример: http://user:pass@1.2.3.4:8080 или socks5://1.2.3.4:1080
# По умолчанию выключено — оставьте пустым или закомментируйте.
# TELEGRAM_PROXY_URL=

# HTTP(S)-прокси для OpenAI API. Если не задан, используется системный
# HTTPS_PROXY (httpx читает его автоматически). По умолчанию выключено.
# OPENAI_PROXY_URL=
# HTTPS_PROXY=

# Путь к файлу БД (по умолчанию ./autovisa.db)
# DB_PATH=/var/lib/autovisa/autovisa.db

# Сколько часов молчания до follow-up (по умолчанию 6)
# FOLLOWUP_HOURS=6

# Как часто планировщик проверяет зависших лидов, минут (по умолчанию 15)
# FOLLOWUP_INTERVAL_MINUTES=15

# Сколько последних сообщений диалога слать в модель (по умолчанию 20)
# HISTORY_LIMIT=20

# Уровень логирования: DEBUG | INFO | WARNING | ERROR (по умолчанию INFO)
# LOG_LEVEL=INFO
